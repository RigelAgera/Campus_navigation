# Auto detect text files and normalize to LF in repo
* text=auto

# Markdown files - always use LF in working tree (cross-platform)
*.md text eol=lf

# C/C++ source files - always LF (cross-platform consistency)
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf

# CMake files
CMakeLists.txt text
*.cmake text

# CSV data files
*.csv text

# Binary files - do not touch line ending conversion
*.png binary
*.jpg binary
*.o binary
*.exe binary
